{
  "name": "plc-monitor",
  "version": "1.0.0",
  "description": "西门子 S7-1200 PLC 变量实时监视系统",
  "main": "electron/main.js",
  "scripts": {
    "dev:backend": "node backend/index.js",
    "dev:frontend": "cd frontend && npx vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npx vite build",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "sql.js": "^1.11.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0",
    "node-snap7": "^1.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.30",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.plcmonitor.app",
    "productName": "PLCMonitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
