{
  "name": "plc-monitor",
  "version": "1.1.0",
  "description": "西门子 S7-1200 PLC 变量实时监视系统",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node backend/index.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "start": "node backend/index.js",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "sql.js": "^1.11.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0",
    "node-snap7": "^1.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.0",
    "uplot": "^1.6.30",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.plcmonitor.app",
    "productName": "PLCMonitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/node-snap7/**",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
